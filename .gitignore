# Local configuration (created from config.example.toml on first run)
config.toml

# Secrets
hf_token
*.token

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# uv.lock is intentionally committed — single machine, reproducible env.

# Logs and local state
logs/
*.log

# Recordings must never end up in the repo
*.wav
*.flac
*.mp3

# Shortcuts. install_autostart.py writes into the Startup folder, not here,
# but a .lnk dragged in to look at should never be committed.
*.lnk

# The VS Code extension's build tree. `dist/` and `build/` above are
# unanchored and already cover the esbuild output; these are the rest.
node_modules/
out/
*.vsix

# Editors / OS
# Three files under .vscode are tracked: settings.json pins the interpreter to
# the project venv, and launch.json + tasks.json are what F5 needs to run the
# extension from source until step 12 packages it.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
Thumbs.db
desktop.ini
