# Local configuration (created from config.example.toml on first run)
config.toml

# Secrets
hf_token
*.token

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# uv.lock is intentionally committed — single machine, reproducible env.

# Logs and local state
logs/
*.log

# Recordings must never end up in the repo
*.wav
*.flac
*.mp3

# Shortcuts. install_autostart.py writes into the Startup folder, not here,
# but a .lnk dragged in to look at should never be committed.
*.lnk

# What the VS Code extension used to leave behind. It was deleted at build step
# 23, and these three lines stay: a node_modules or a .vsix appearing in this
# repository now would be somebody starting it again, and the point of deleting
# it was that there is one UI.
node_modules/
out/
*.vsix

# Editors / OS
# One file under .vscode is tracked: settings.json, which pins the interpreter to
# the project venv. launch.json and tasks.json went with the extension at step
# 23 — they existed only to run it from source under F5.
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
desktop.ini
