{
  // Run the extension from source. Step 12 packages it into a .vsix; until
  // then this is how it is installed.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Referat extension",
      "type": "extensionHost",
      "request": "launch",
      // The repository folder is passed as well as the development path.
      // `--extensionDevelopmentPath` says which extension to load, not which
      // folder to open, and the host otherwise comes up on whatever it had
      // last -- often nothing. cli.ts has a fallback for that case now, but
      // opening the repo is what makes the tree useful rather than merely
      // functional.
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/referat-vscode",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/referat-vscode/dist/**/*.js"],
      "preLaunchTask": "npm: watch - referat-vscode"
    }
  ]
}
