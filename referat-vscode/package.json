{
  "name": "referat-vscode",
  "displayName": "Referat",
  "description": "Browse Referat meetings, tag them with projects, write their notes, and name the speakers identification could not place.",
  "version": "0.2.0",
  "publisher": "niklas-elmqvist",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickelm/referat.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:referat.meetings"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "referat",
          "title": "Referat",
          "icon": "media/referat.svg"
        }
      ]
    },
    "views": {
      "referat": [
        {
          "id": "referat.meetings",
          "name": "Meetings",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "referat.refresh",
        "title": "Refresh",
        "category": "Referat",
        "icon": "$(refresh)"
      },
      {
        "command": "referat.projects",
        "title": "Projects",
        "category": "Referat",
        "icon": "$(tag)"
      },
      {
        "command": "referat.openMeetingsFolder",
        "title": "Open Meetings Folder",
        "category": "Referat",
        "icon": "$(folder-opened)"
      },
      {
        "command": "referat.showOutput",
        "title": "Show Output",
        "category": "Referat"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "referat.projects",
          "when": "view == referat.meetings",
          "group": "navigation@1"
        },
        {
          "command": "referat.refresh",
          "when": "view == referat.meetings",
          "group": "navigation@2"
        },
        {
          "command": "referat.openMeetingsFolder",
          "when": "view == referat.meetings",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Referat",
      "properties": {
        "referat.repoRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Referat repository — the folder holding `pyproject.toml`. Everything else, including where the meetings live, is read from that repository's `config.toml` so the extension and the tray cannot disagree about it. Left empty, the extension looks through the open workspace folders for one that looks like the repository."
        },
        "referat.claudeBinary": {
          "type": "string",
          "default": "",
          "markdownDescription": "Full path to the `claude` binary used by *Generate notes*. Left empty, the extension asks VS Code for the installed Claude Code extension and takes the binary inside it, and only then looks on `PATH`."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
