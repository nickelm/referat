// Typechecking only. esbuild does every emit -- see esbuild.mjs -- so this file
// deliberately carries no output settings at all.
//
// It used to set "outDir": "out" and "sourceMap": true, which were inert (the
// only consumer is `tsc --noEmit`) right up until they were not: TypeScript 6
// requires an explicit "rootDir" whenever "outDir" is set, so VS Code's bundled
// language service began reporting "The common source directory of
// 'tsconfig.json' is './src'. The 'rootDir' setting must be explicitly set" --
// an error about a layout for files this project never writes. Adding "rootDir"
// would have answered it; deleting the emit settings answers it and stops the
// file claiming to emit something.
{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
